<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
        
        
<bean class ="in.sp.beans.Address" id ="addId"><!-- Unique id is necessary in dependency injection -->
<property name="houseno" value ="111"/>
<property name="city" value ="Mumbai"/>
<property name="pincode" value ="123456"/>

</bean>

<bean class="in.sp.beans.Student" id="stdId">
<property name="rollno" value ="101"/>
<property name="name" value ="Abhijeet"/>
<property name="address" ref ="addId"/><!-- inject the id here we are injecting object so we use ref attribute  -->

</bean>
</beans>