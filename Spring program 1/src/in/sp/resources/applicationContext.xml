<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="stdId" class="in.sp.beans.Student">
        <property name="name" value="Abhijeet"/>
        <property name="rollno" value="101"/>
        <property name="email" value="abhijeet@gmail.com"/>
    </bean>



    <bean id="stdId2" class="in.sp.beans.Student">
        <property name="name" value="Vijay"/>
        <property name="rollno" value="102"/>
        <property name="email" value="vijay@gmail.com"/>
    </bean>


    <bean id="stdId3" class="in.sp.beans.Student">
        <property name="name" value="Vikram"/>
        <property name="rollno" value="103"/>
        <property name="email" value="vikram@gmail.com"/>
    </bean>



</beans>