<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
        
        
<bean class ="in.sp.beans.Address" id ="addId"><!-- Unique id is necessary in dependency injection -->
<constructor-arg value = "222"/><!-- Here constructor is used in const di -->
<constructor-arg value = "Delhi"/>
<constructor-arg value = "12345"/>
</bean>

<bean class="in.sp.beans.Student" id="new1">
<constructor-arg value = "102"/><!-- be very careful with the order -->
<constructor-arg value = "Vijay"/>
<constructor-arg ref = "addId"/>

</bean>
</beans>