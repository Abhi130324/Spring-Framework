<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

   <bean class ="in.sp.beans.Address" id = "address"><!-- addresss -->
   <property name="houseno" value ="100"/>
   <property name="city" value ="Bangalore"/>
   <property name="pincode" value ="124552"/>
  </bean> 
  
  
  <bean class ="in.sp.beans.Student" id ="std" autowire="byName">
  <property name="name" value= "ABhijeet"/>
  <property name="rollno" value= "36"/>
  </bean>
  
  
  
</beans>